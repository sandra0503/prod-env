			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [
				480,
				0
			],
			"parameters": {
				"jsCode": "const byZone = {};\nfor (const { json } of $input.all()) {\n  const z = (byZone[json.zone] ??= { zone: json.zone, n: 0, temp: 0, rh: 0 });\n  z.n++; z.temp += json.temperature_c; z.rh += json.humidity_pct;\n}\nreturn Object.values(byZone).map((z) => ({ json: { zone: z.zone, avg_temp: +(z.temp / z.n).toFixed(1), avg_rh: +(z.rh / z.n).toFixed(0) } }));"
			}
		},
